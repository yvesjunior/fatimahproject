# Production Docker Compose config
# Copy this to .env on your production server and fill in values

WEB_PORT=80
APP_KEY=GENERATE_NEW_KEY
APP_URL=https://yourdomain.com
SESSION_DOMAIN=yourdomain.com

# Path to the checked-out repo on the server (mounted into the container)
APP_SOURCE_PATH=/opt/fatimaproject

# External PostgreSQL (managed instance, or Postgres on the host VM).
# When Postgres runs on the host VM, use DB_HOST=host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=fatimaproject
DB_USERNAME=fatimaproject
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer
